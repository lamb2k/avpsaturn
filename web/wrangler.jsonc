{
  "name": "avp-private-test",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    { "name": "SIGNIN_LIMIT", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } }
  ],
  "routes": [{ "pattern": "avp.retronetplay.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "TEST_FILES", "bucket_name": "avp-private-test" }],
  "assets": { "directory": "./.site", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "observability": { "enabled": true }
}
