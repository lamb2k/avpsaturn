{
  "name": "avp-web-test",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "avp.retronetplay.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "TEST_FILES", "bucket_name": "avp-web-test" }],
  "assets": { "directory": "./.site", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "observability": { "enabled": true }
}
