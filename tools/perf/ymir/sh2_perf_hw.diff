-        }
-        break;
-    case 0b010: // associative purge
-        m_cache.AssociativePurge(address);
-        if constexpr (!poke) {
-            devlog::trace<grp::cache>(m_logPrefix, "[PC = {:08X}] {}-bit SH-2 associative purge write to {:08X} = {:X}",
