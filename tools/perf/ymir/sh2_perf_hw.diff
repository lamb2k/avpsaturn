-// lane perf 2026-11-12: GS_HW=1 swaps the bus access cycles for the table Ymir's own saturn.cpp keeps commented out ("pass misctest, but too slow in practice due to inaccurate SH2 cache, write buffer and BSC emulation"): a pessimistic bound for the console's memory cost.
-static inline uint64 GsHw(uint32 address, uint64 c, int bytes) {
-    static const bool on = [] { const char *e = std::getenv("GS_HW"); return e && e[0] == '1'; }();
-    if (!on) return c;
-    uint32 a = address & 0x1FFFFFFFu;
-    if (a >= 0x06000000u) return 8;
-    if (a >= 0x00200000u && a < 0x00300000u) return bytes == 4 ? 16 : 8;
-    if (a >= 0x02000000u && a < 0x05000000u) return bytes == 4 ? 8 : 4;
-    if (a >= 0x05A00000u && a < 0x05C00000u) return 47;
-    if (a >= 0x05C00000u && a < 0x05D00000u) return 45;
-    if (a >= 0x05D00000u && a < 0x05D80000u) return 29;
-    if (a >= 0x05E00000u && a < 0x05FC0000u) return 40;
-    if (a >= 0x05FE0000u && a < 0x05FF0000u) return 8;
-    return c;
-}
-template <mem_primitive T, bool write, bool emulateCache>
-FORCE_INLINE_EX uint64 SH2::AccessCycles(uint32 address) {
-    const uint32 partition = (address >> 29u) & 0b111;
-    switch (partition) {
-    case 0b000: // cache
-        if constexpr (emulateCache && !write) {
-            // Check for cache hit
-            CacheEntry &entry = m_cache.GetEntry(address);
-            uint32 way = entry.FindWay(address);
-
-            if (IsValidCacheWay(way)) {
-                return 1;
-            } else {
-                // Cache miss - fill cache line
-                // TODO: stall bus for 4 accesses
-                return GsHw(address, m_bus.GetAccessCycles<T, write>(address), (int)sizeof(T));
-            }
-        } else if constexpr (!emulateCache) {
-            // Simplified model - assume cache hits on all accesses to cached area
-            return 1;
-        }
-        [[fallthrough]];
-    case 0b001: [[fallthrough]];
-    case 0b101: // cache-through
-        return GsHw(address, m_bus.GetAccessCycles<T, write>(address), (int)sizeof(T));
-    case 0b010: return 1;        // associative purge
-    case 0b011: return 1;        // cache address array
-    case 0b100: [[fallthrough]]; // cache data array
-    case 0b110: return 1;        // cache data array
-    case 0b111: return 4;        // I/O area
-    }
-
-    util::unreachable();
-}
-
-template <bool emulateCache>
-uint64 SH2::AccessCyclesRMWByte(uint32 address) {
-    const uint32 partition = (address >> 29u) & 0b111;
-    switch (partition) {
-    case 0b000:                  // cache
-    case 0b001: [[fallthrough]]; // cache-through
-    case 0b101:                  // cache-through
-    {
-        const uint64 readCycles = GsHw(address, m_bus.GetAccessCycles<uint8, false>(address), 1);
-        return readCycles - 1;
-    }
-    default: // everything else
-        return AccessCycles<uint8, false, emulateCache>(address) + AccessCycles<uint8, true, emulateCache>(address);
-    }
-}
