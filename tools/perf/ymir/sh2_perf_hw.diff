+    if (a0 == 0x05F80092u && (++avpScy2 % 60u)==0) AvpStatsLine(avpScy2);
+    if (a0 >= 0x05C00000u && a0 < 0x05C80000u) { unsigned o=a0-0x05C00000u;
+        if (bits==32){avpV1[o&~3u]=value>>24;avpV1[(o&~3u)+1]=value>>16;avpV1[(o&~3u)+2]=value>>8;avpV1[(o&~3u)+3]=value;}
+        else if(bits==16){avpV1[o&~1u]=value>>8;avpV1[(o&~1u)+1]=value;} else avpV1[o]=value; }
+    if (a0 == 0x05F80092u && (avpScy2 % 120u)==0) AvpV1Dump(avpScy2);
+    return;
+    unsigned a = address & 0x1FFFFFFFu;
+    bool hit = false;
+    if (a >= 0x00100000u && a < 0x00100080u) hit = true;                       // SMPC
+    else if (a >= 0x05B00000u && a < 0x05B00EF0u) hit = true;                  // SCSP slot and common registers
+    else if (a >= 0x05890000u && a < 0x058A0000u) hit = true;                  // CD block
+    else if (a >= 0x05D00000u && a < 0x05D00020u) hit = true;                  // VDP1 registers
+    else if (a >= 0x05F80000u && a < 0x05F80120u) hit = true;                  // VDP2 registers
+    else if (a >= 0x05FE0000u && a < 0x05FF0000u) hit = true;                  // SCU
+    else if (a == 0x057EFFFEu || a == 0x057FFFFEu) hit = true;                 // cart enable
+    else if (a == 0x01000000u || a == 0x01800000u) hit = true;                 // SINIT / MINIT
+    else if ((address >> 29) == 7 && ((address >= 0xFFFFFE00u && address < 0xFFFFFF00u) || address >= 0xFFFFFF80u)) hit = true;   // on-chip registers (not the DIVU)
+    if (!hit) return;
+    static bool app = false;
+    if ((pc & 0x1FFFFFFFu) >= 0x06004000u) app = true;
+    if (!app && !(a >= 0x00100000u && a < 0x00100080u)) return;   // before the first app instruction only the SMPC is logged
+    static unsigned long long n = 0;
+    if (n++ > 4000000) return;
+    if (std::FILE *f = AvpRegFile()) { std::fprintf(f, "%llu %.*s PC=%08X W%u %08X %X\n", ++avpSeq, (int)who.size(), who.data(), pc, bits, address, value); }
+}
+static void AvpLogEv(std::string_view who, unsigned vec, unsigned pc) {
+    if (vec < 12 || (vec >= 0x40 && vec <= 0x4F) || vec == 0x70) {
+        static unsigned long long n = 0;
+        if (n++ > 200000) return;
+        if (std::FILE *f = AvpRegFile()) std::fprintf(f, "%llu %.*s EV vec=%u pc=%08X\n", ++avpSeq, (int)who.size(), who.data(), vec, pc);
+    }
+}
+static void AvpLogMisalign(const char *kind, std::string_view who, unsigned pc, unsigned size, unsigned addr) {
+    static std::FILE *f = std::fopen("E:/AvP/learning/lane-perf-hw/ymir_hw/ymir_misalign.log", "w");
+    static std::set<unsigned long long> seen;
+    unsigned long long k = ((unsigned long long)pc << 16) ^ (size << 4) ^ (unsigned)kind[0] ^ ((unsigned long long)who.size() << 8) ^ ((unsigned long long)(who.empty() ? 0 : who[0]) << 40);
+    if (f && seen.insert(k).second) { std::fprintf(f, "%s %.*s PC=%08X addr=%08X %u-bit\n", kind, (int)who.size(), who.data(), pc, addr, size); std::fflush(f); }
+}
