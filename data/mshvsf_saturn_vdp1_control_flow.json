    },
    {
      "claim": "The command table holds more non-zero slots than the current list reaches; the excess is residue from longer earlier lists.",
      "consequence": "Non-zero extent is not this frame's command count and is not an allocator high-water mark.",
      "evidence": "MEASURED",
      "falsification": "A capture whose non-zero slot count equals its reachable slot count while the list length varies between frames.",
      "holds": true,
      "id": "VDP1-CF-2"
    },
    {
      "claim": "Actor and background sprites are drawn one VDP1 command per 16x16 tile rather than as precomposed cels.",
      "consequence": "Command-table pressure scales with visible tile count, so a tile pipeline is the strategy this reference port actually uses.",
      "evidence": "MEASURED",
      "falsification": "Any drawn command with a size other than 16x16, or a scaled or distorted sprite command in the reachable set.",
      "holds": true,
      "id": "VDP1-CF-3"
    },
    {
      "claim": "Horizontal flip is expressed in CMDCTRL, not by storing mirrored art.",
      "consequence": "Facing costs no extra texture memory on this hardware path.",
      "evidence": "MEASURED",
      "falsification": "An anchor in which no command sets the character-read-direction bits while the actor is visibly mirrored.",
      "holds": true,
      "id": "VDP1-CF-4"
    }
