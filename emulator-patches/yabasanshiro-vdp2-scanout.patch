+namespace game_testing
+{
+   struct ScanoutLog {
+      FILE *file;
+      unsigned int samples;
+   };
+
+   static void runner_scanout_callback(const pixel_t *pixels, int width,
+                                       int height, int interlace, u64 frame,
+                                       void *user)
+   {
+      ScanoutLog *log = (ScanoutLog *)user;
+      const unsigned char *bytes = (const unsigned char *)pixels;
+      size_t count = (size_t)width * (size_t)height * sizeof(pixel_t);
+      u64 hash = 1469598103934665603ULL;
+      size_t i;
+      for (i = 0; i < count; i++)
+         hash = (hash ^ bytes[i]) * 1099511628211ULL;
+      fprintf(log->file,
+              "frame=%llu width=%d height=%d interlace=%d fnv1a64=%016llx\\n",
+              (unsigned long long)frame, width, height, interlace,
+              (unsigned long long)hash);
+      log->samples++;
+   }
+
+   int run_scanout(const std::string &disc, unsigned int frames,
+                   const std::string &report_path)
+   {
+      ScanoutLog log = { fopen(report_path.c_str(), "wb"), 0 };
+      if (log.file == NULL) {
+         fprintf(stderr, "could not open scanout report: %s\\n", report_path.c_str());
+         return 2;
+      }
+      if (init_game(disc) < 0) {
+         fclose(log.file);
+         return 3;
+      }
+      VIDSoftSetScanoutCallback(runner_scanout_callback, &log);
+      for (unsigned int i = 0; i < frames; i++) {
+         PERCore->HandleEvents();
+      }
+      VIDSoftSetScanoutCallback(NULL, NULL);
+      fclose(log.file);
+      printf("scanout samples=%u\\n", log.samples);
+      return log.samples == frames ? 0 : 4;
+   }
+}
