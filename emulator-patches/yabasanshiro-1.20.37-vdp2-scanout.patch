+struct ScanoutLog
+{
+   std::ofstream stream;
+   unsigned long first_frame;
+   unsigned long last_frame;
+   std::vector<u32> probes;
+};
+
+static uint64_t fnv1a64(const unsigned char *data, size_t length)
+{
+   uint64_t value = UINT64_C(14695981039346656037);
+   for (size_t i = 0; i < length; i++) {
+      value ^= data[i];
+      value *= UINT64_C(1099511628211);
+   }
+   return value;
+}
+
+static void record_scanout(const pixel_t *rgba, int width, int height,
+                           int interlace, unsigned long frame, void *userdata)
+{
+   ScanoutLog *log = (ScanoutLog *)userdata;
+   if (log == NULL || frame < log->first_frame || frame > log->last_frame)
+      return;
+   uint64_t hash = fnv1a64((const unsigned char *)rgba,
+                           (size_t)width * (size_t)height * sizeof(pixel_t));
+   char hash_text[17] = { 0 };
+   sprintf(hash_text, "%016llx", (unsigned long long)hash);
+   log->stream << "{\"emulator_frame\":" << frame
+               << ",\"width\":" << width
+               << ",\"height\":" << height
+               << ",\"interlace\":" << interlace
+               << ",\"pixel_format\":\"pixel_t_native_rgba\""
+               << ",\"fnv1a64\":\"" << hash_text << "\"";
+   if (!log->probes.empty()) {
+      log->stream << ",\"probes\":{";
+      for (size_t i = 0; i < log->probes.size(); i++) {
+         char address[16] = { 0 };
+         sprintf(address, "0x%08x", log->probes[i]);
+         if (i != 0)
+            log->stream << ",";
+         log->stream << "\"" << address << "\":"
+                     << MappedMemoryReadLong(log->probes[i], NULL);
+      }
+      log->stream << "}";
+   }
+   log->stream << "}\n";
+   log->stream.flush();
+}
+
+static int run_scanout(const std::string &disc, unsigned long frames,
+                       const std::string &output, const std::string &probe_csv)
+{
+   yabauseinit_struct yinit = { 0 };
+   ScanoutLog log;
+   log.stream.open(output.c_str(), std::ios::out | std::ios::trunc);
+   if (!log.stream) {
+      std::cerr << "Cannot open scanout metadata: " << output << std::endl;
+      return 2;
+   }
+   log.first_frame = 0;
+   log.last_frame = frames;
+   std::stringstream probe_stream(probe_csv);
+   std::string probe_text;
+   while (std::getline(probe_stream, probe_text, ',')) {
+      char *end = NULL;
+      unsigned long value;
+      if (probe_text.empty())
+         continue;
+      value = strtoul(probe_text.c_str(), &end, 0);
+      if (*end != '\0' || value > 0xffffffffUL) {
+         std::cerr << "Invalid scanout probe address: " << probe_text << std::endl;
+         return 2;
+      }
+      log.probes.push_back((u32)value);
+   }
+   yinit.percoretype = PERCORE_DUMMY;
+#if DYNAREC_DEVMIYAX
+   yinit.sh2coretype = SH2Dyn.id;
+#else
+   yinit.sh2coretype = SH2CORE_INTERPRETER;
+#endif
+   yinit.vidcoretype = VIDCORE_SOFT;
+   /* Match Qt's configured default: C68K when built, not the unavailable
+      Musashi id that this runner does not register. */
+   yinit.m68kcoretype = M68KCORE_C68K;
+   yinit.sndcoretype = SNDCORE_DUMMY;
+   yinit.cdcoretype = CDCORE_ISO;
+   yinit.carttype = CART_DRAM32MBIT;
+   yinit.regionid = REGION_AUTODETECT;
+   yinit.biospath = NULL; /* HLE: equivalent diagnostic choice is logged. */
+   yinit.cdpath = disc.c_str();
+   yinit.buppath = "runner-scanout.bup";
+   yinit.cartpath = "runner-scanout.dram";
+   yinit.frameskip = 0;
+   yinit.videoformattype = VIDEOFORMATTYPE_NTSC;
+   yinit.clocksync = 0;
+   yinit.basetime = 0;
+   yinit.skip_load = 0;
+   yinit.numthreads = 0;
+   yinit.usethreads = 0;
+   yinit.use_new_scsp = 1;
+   /* Qt's default is unthrottled; this only affects host pacing but keeping
+      the same setting removes it as an execution-path variable. */
+   yinit.framelimit = 0;
+   VIDSoftSetScanoutCallback(record_scanout, &log);
+   std::cout << "scanout calling YabauseInit" << std::endl;
+   if (YabauseInit(&yinit) != 0) {
+      std::cerr << "YabauseInit failed for scanout route" << std::endl;
+      VIDSoftSetScanoutCallback(NULL, NULL);
+      return 3;
+   }
+   std::cout << "scanout init ok; cart=32mbit; hle=1; frames=" << frames << std::endl;
+   PerPortReset();
+   PerPadAdd(&PORTDATA1);
+   for (unsigned long i = 0; i < frames; i++) {
+      if ((i % 60) == 0)
+         std::cout << "scanout exec frame=" << i << std::endl;
+      // PERDummyHandleEvents owns exactly one YabauseExec call, matching
+      // YabauseThread::execEmulation in the Qt port. Calling YabauseExec
+      // again here advances the guest twice per requested scanout frame.
+      if (PERCore->HandleEvents() != 0) {
+         std::cerr << "PERCore->HandleEvents failed at frame " << i << std::endl;
+         YabauseDeInit();
+         VIDSoftSetScanoutCallback(NULL, NULL);
+         return 4;
+      }
+   }
+   YabauseDeInit();
+   VIDSoftSetScanoutCallback(NULL, NULL);
+   return 0;
+}
+
+#ifdef _MSC_VER
+static LONG WINAPI scanout_exception_filter(EXCEPTION_POINTERS *info)
+{
+   void *stack[32] = { 0 };
+   USHORT count = CaptureStackBackTrace(0, 32, stack, NULL);
+   fprintf(stderr, "scanout exception code=0x%08lx address=%p stack=",
+           (unsigned long)info->ExceptionRecord->ExceptionCode,
+           info->ExceptionRecord->ExceptionAddress);
+   for (USHORT i = 0; i < count; i++)
+      fprintf(stderr, "%p%s", stack[i], i + 1 == count ? "" : ",");
+   fprintf(stderr, "\n");
+   fflush(stderr);
+   return EXCEPTION_EXECUTE_HANDLER;
+}
+#endif
